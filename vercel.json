{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/assistidos",
      "destination": "/api/assistidos.js"
    },
    {
      "source": "/api/assistidos/(.*)",
      "destination": "/api/assistidos.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
